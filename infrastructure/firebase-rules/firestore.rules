rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — client can read own doc, but CANNOT write credits/isPaid
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.credits == 3
        && request.resource.data.isPaid == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['credits', 'isPaid', 'plan']);
      allow delete: if false;
    }

    // Jobs — users can only read their own jobs; all writes via Admin SDK
    match /jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Fingerprints & upload_attempts — server-only
    match /fingerprints/{id} {
      allow read, write: if false;
    }
    match /upload_attempts/{id} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
