# ========================================
# ViralClip AI — Environment Variables
# Copy to .env and fill in real values
# ========================================

# --- Firebase (Client — Next.js) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- Firebase (Admin — Backend) ---
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=viralclip-videos
R2_PUBLIC_URL=https://your-r2-custom-domain.com

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000

# --- Security ---
ADMIN_SECRET=change_this_to_a_strong_random_secret
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Whisper ---
WHISPER_MODEL=medium

# --- App Config ---
WATERMARK_TEXT=ViralClip AI
FREE_TRIAL_CREDITS=3
VIDEO_EXPIRY_DAYS=7
